+bool NativeAdrenoVm::reserveRanges(size_t more)
+{
+    /* map() stages a mapping's ranges in the free tail and insert() may copy them once more past it. */
+    const size_t need=spanCount()+2*more;
+    if(need<=capacity_)return true;
+    if(need>NativeAdrenoVmMaxRanges)return false;
+    size_t capacity=capacity_;while(capacity<need)capacity*=2;
+    if(capacity>NativeAdrenoVmMaxRanges)capacity=NativeAdrenoVmMaxRanges;
+    ArmSmmu4KRange *grown=IONewData(ArmSmmu4KRange,capacity);
+    if(!grown)return false;
+    memcpy(grown,ranges_,spanCount()*sizeof(*ranges_));
+    IODeleteData(ranges_,ArmSmmu4KRange,capacity_);
+    ranges_=grown;capacity_=capacity;
+    return true;
+}
