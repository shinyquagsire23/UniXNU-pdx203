+void NativeAdrenoGpuContext::enableClientSpaces()
+{
+    if(!ready_)return;
+    /* The live context's own checks then accept a TTBR0 the CP switched (any root, this ASID). */
+    smmu_.setDeviceSwitched();
+    spaces_=true;
+}
+IOReturn NativeAdrenoGpuContext::createSpace(size_t range_capacity,NativeAdrenoClientSpace **out,NativeAdrenoClientSpaceInfo *info)
+{
+    if(!out || !info)return kIOReturnBadArgument;
+    *out=nullptr;*info={};
+    if(!ready_ || !spaces_)return kIOReturnNotReady;
+    volatile uint32_t *st=native_adreno_space_stats;
+    unsigned step=0;
+    auto failed=[&](IOReturn status,NativeAdrenoClientSpace *space)->IOReturn {
+        st[3]=st[3]+1;st[4]=(uint32_t)status;
+        IOLog("NativeAdrenoSpace: creation failed at step %u: %x\n",step,status);IOSleep(30);
+        if(space)(void)destroySpace(space);
+        return status;
+    };
+    NativeAdrenoClientSpace *space=new NativeAdrenoClientSpace;
+    if(!space)return failed(kIOReturnNoMemory,nullptr);
+    /* The live table's format (its input bits, so the bank's TCR fits) over [0, ClientApertureBytes): a level-1 root, one level-2 table a
+     * GiB and one level-3 table per 2 MiB. Cacheable contiguous memory first (pool pages are write-combined, and table updates through such a
+     * mapping were 2.6x slower, int-153), then the BO pool. */
+    const unsigned input_bits=smmu_.arena()->config.input_bits;
+    const size_t pages=1+size_t((ClientApertureBytes+(UINT64_C(1)<<30)-1)>>30)+size_t((ClientApertureBytes+(UINT64_C(1)<<21)-1)>>21);
+    step=1;IOReturn status=space->tables.allocate(pages*0x1000,output_bits_,true,pages*0x1000);
+    if(status) {
+        status=space->tables.allocate(pages*0x1000,output_bits_,true,pages*0x1000,true);
+        if(!status)st[6]=st[6]+1;
+    }
+    if(status)return failed(status,space);
+    step=2;status=space->smmu.prepare(&space->tables,0,0,ClientApertureBytes,size_t(ClientApertureBytes>>12),bank_,asid_,1000,output_bits_,input_bits);
+    if(status)return failed(status,space);
+    space->smmu.setDeviceSwitched();
+    space->smmu.setAliasScratch(alias_scratch_,sizeof alias_scratch_/sizeof *alias_scratch_);
+    NativeAdrenoVmRegion lower={&space->tables,space->smmu.arenaHandle(),space->smmu.stateHandle()};
+    /* The live context's io and stream routes: one bank, one set of streams, the tables alone are the client's. */
+    step=3;IOLog("NativeAdrenoSpace: tables %zu pages at %llx, attaching\n",pages,(unsigned long long)space->tables.spans()[0].physical);IOSleep(30);
+    status=space->vm.attach(smmu_.ioHandle(),space->smmu.configHandle(),smmu_.streamsHandle(),&lower,nullptr,range_capacity,262144);
+    if(status)return failed(status,space);
+    space->attached=true;step=4;
+    for(unsigned i=0;!status && i<GpuBufferCount;++i)
+        status=space->vm.map(&buffers_[i],0,kIovas[i],i?3u:5u,0,2,&space->handles[i]);
+    if(status)return failed(status,space);
+    *out=space;
+    *info={&space->vm,space->smmu.stateHandle()->tables.root_physical,ClientVaStart,ClientApertureBytes-ClientVaStart};
+    st[0]=st[0]+1;st[2]=st[2]+1;if(st[2]>st[7])st[7]=st[2];st[5]=st[5]+(uint32_t)((pages*0x1000)>>20);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoGpuContext::destroySpace(NativeAdrenoClientSpace *space)
+{
+    if(!space)return kIOReturnBadArgument;
+    volatile uint32_t *st=native_adreno_space_stats;
+    const bool counted=space->handles[GpuBufferCount-1]!=0;
+    if(space->attached) {
+        for(unsigned i=0;i<GpuBufferCount;++i)if(space->handles[i]) {
+            const IOReturn unmapped=space->vm.unmap(space->handles[i]);
+            if(unmapped)return unmapped;   /* kept: its tables may still be in use */
+            space->handles[i]=0;
+        }
+        const IOReturn detached=space->vm.detach();
+        if(detached)return detached;
+        space->attached=false;
+    }
+    if(space->tables.backed()) {
+        const size_t bytes=space->tables.bytes();
+        if(space->tables.deviceReferences()) {
+            const IOReturn retired=space->tables.retireAfterQuiescence();
+            if(retired)return retired;
+        }
+        const IOReturn released=space->tables.release();
+        if(released)return released;
+        if(counted)st[5]=st[5]-(uint32_t)(bytes>>20);
+    }
+    if(counted) {st[1]=st[1]+1;st[2]=st[2]-1;}
+    delete space;
+    return kIOReturnSuccess;
+}
