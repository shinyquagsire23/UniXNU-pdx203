Subject: [PATCH] client: live BOs per client slot by size (native_adreno_client_hist)

The render server's live-object count climbs with each app switch while the
kernel leaks nothing; the board's METALHIST row shows what the live BOs are
made of: owned BOs per size bucket (4 KiB .. 16 MiB, larger), their KiB, and
imports, per client slot.
---
diff --git a/NativeAdrenoUserClient.cpp b/NativeAdrenoUserClient.cpp
--- a/NativeAdrenoUserClient.cpp
+++ b/NativeAdrenoUserClient.cpp
@@ -193,6 +193,16 @@ static volatile uint32_t *clientStats(uint32_t queue_base,uint64_t window_bytes)
     const uint32_t slot=window_bytes?queue_base/NativeAdrenoAbiMaxQueues:4;
     return native_adreno_client_stats[slot<4?slot:4];
 }
+/* Live BOs per client slot by size (pdx203: what a client's live-object count that climbs with each app switch is made of): [0..7] owned
+ * BOs of at most 4 KiB, 16 KiB, 64 KiB, 256 KiB, 1 MiB, 4 MiB, 16 MiB, and larger; [8] their KiB; [9] imports. */
+extern "C" {volatile uint32_t native_adreno_client_hist[5][10];}
+static void noteHist(uint32_t queue_base,uint64_t window_bytes,uint64_t bytes,bool imported,int delta) {
+    const uint32_t slot=window_bytes?queue_base/NativeAdrenoAbiMaxQueues:4;
+    volatile uint32_t *h=native_adreno_client_hist[slot<4?slot:4];
+    if(imported) {h[9]=h[9]+(uint32_t)delta;return;}
+    unsigned bucket=0;for(uint64_t limit=4096;bucket<7 && bytes>limit;limit<<=2)++bucket;
+    h[bucket]=h[bucket]+(uint32_t)delta;h[8]=h[8]+(uint32_t)(delta*(int64_t)(bytes>>10));
+}
 static void noteLive(uint32_t queue_base,uint64_t window_bytes,size_t live) {
     volatile uint32_t *stats=clientStats(queue_base,window_bytes);
     stats[0]=(uint32_t)live;if(live>stats[1])stats[1]=(uint32_t)live;
@@ -201,6 +211,7 @@ IOReturn NativeAdrenoUserClient::allocBo(const NativeAdrenoAbiBoAlloc *request,
     NativeAdrenoAbiBoAllocReply *reply)
 {
     const IOReturn status=allocBoInner(request,reply);
+    if(!status && request)noteHist(queue_base_,window_bytes_,request->bytes,false,1);
     if(status && request) {
         volatile uint32_t *stats=clientStats(queue_base_,window_bytes_);
         stats[2]=stats[2]+1;stats[3]=(uint32_t)status;stats[4]=(uint32_t)request->bytes;
@@ -273,6 +284,7 @@ IOReturn NativeAdrenoUserClient::importBo(const NativeAdrenoAbiBoImport *request
     entry->mapped=0;entry->iova=0;entry->mapped_state=false;entry->imported=true;
     reply->handle=entry->handle;
     native_adreno_import_live[0]=native_adreno_import_live[0]+1;
+    noteHist(queue_base_,window_bytes_,request->bytes,true,1);
     {
         const unsigned slot=3+(gImportNext++%8)*4;
         native_adreno_import_live[slot]=request->address;native_adreno_import_live[slot+1]=(uint64_t)proc_selfpid()<<40|request->bytes;
@@ -359,8 +371,10 @@ IOReturn NativeAdrenoUserClient::freeBo(const NativeAdrenoAbiBoFree *request)
         noteFreed(entry->iova,entry->memory.bytes(),entry->handle,ring_?ring_->lastSubmitted():0,ring_?ring_->completedFence():0);
         entry->mapped_state=false;entry->mapped=0;entry->iova=0;
     }
+    const uint64_t freed_bytes=entry->memory.bytes();const bool freed_import=entry->imported;
     const IOReturn release=entry->memory.release();
     if(release) {noteFreeRefused(entry->imported,entry->handle,release);return release;}
+    noteHist(queue_base_,window_bytes_,freed_bytes,freed_import,-1);
     if(entry->imported) {native_adreno_import_live[0]=native_adreno_import_live[0]-1;noteImportState(entry->handle,2);}
     clear(*entry);
     return kIOReturnSuccess;
