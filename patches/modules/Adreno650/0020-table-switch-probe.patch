+/* Per-process page tables, step 0 (pdx203): a second TTBR0 table, built by the kit's ArmSmmu4KBuild in the live table's format, that maps
+ * the five kernel buffers at their GPU addresses, except that the scratch page's address leads to a page of its own (probe). The board
+ * switches the CP to it with CP_SMMU_TABLE_UPDATE, writes through the scratch address and switches back: the write landing in the probe
+ * page, and not in the scratch page, is the switch working. Built once; its memory is kept. */
+struct NativeAdrenoGpuTableProbe {
+    uint64_t root_physical;      /* the probe table's root (TTBR0 address bits) */
+    uint64_t live_root_physical; /* the live table's root */
+    uint64_t probe_physical;     /* the page the probe table maps at GpuScratchIova */
+    volatile uint32_t *probe;    /* its kernel mapping (cacheable: invalidate before reading) */
+    volatile uint32_t *scratch;  /* the real scratch page's kernel mapping */
+    uint32_t table_pages,start_level,input_bits,status;
+    uint64_t mair,live_mair;
+    uint64_t ring_leaf,live_ring_leaf;   /* the level-3 descriptor of GpuRingIova in each table (format check; 0: not found) */
+};
+extern "C" IOReturn NativeAdrenoGpuContextTableProbe(NativeAdrenoGpuTableProbe *out);
 /* The live VM of the ready GPU context (null before Ready), for the user-client core. */
 extern "C" NativeAdrenoVm *NativeAdrenoGpuContextVm();
 #endif
