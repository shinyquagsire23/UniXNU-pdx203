+/* The level-3 descriptor of iova in a table pool of `pages` pages at physical base, through its CPU mapping (0 when absent). */
+static uint64_t leafOf(const uint8_t *cpu,uint64_t base,size_t pages,uint64_t root,unsigned start,unsigned input_bits,uint64_t iova)
+{
+    uint64_t table=root;
+    for(unsigned level=start;level<=3;++level) {
+        if(table<base || table-base>=pages*0x1000)return 0;
+        const unsigned shift=39-9*level;
+        const unsigned width=level==start?input_bits-shift:9;
+        const uint64_t index=(iova>>shift)&((UINT64_C(1)<<width)-1);
+        const uint64_t desc=reinterpret_cast<const volatile uint64_t *>(cpu+(table-base))[index];
+        if(level==3)return desc;
+        if((desc&3)!=3)return 0;
+        table=desc&UINT64_C(0x0000fffffffff000);
+    }
+    return 0;
+}
+IOReturn NativeAdrenoGpuContext::tableProbe(NativeAdrenoGpuTableProbe *out)
+{
+    enum : size_t {TablePagesProbe=6,ProbePage=7,ProbeBytes=8*0x1000};
+    *out={};
+    if(!ready_)return kIOReturnNotReady;
+    if(!probe_.backed()) {
+        IOReturn status=probe_.allocate(ProbeBytes,output_bits_,true,ProbeBytes);
+        if(status)return status;
+    }
+    if(probe_.spanCount()!=1 || !probe_.mapping())return kIOReturnUnsupported;
+    const uint64_t base=probe_.spans()[0].physical;
+    uint8_t *cpu=static_cast<uint8_t *>(probe_.mapping());
+    bzero(cpu,ProbeBytes);
+    ArmSmmu4KRange ranges[GpuBufferCount];
+    for(unsigned i=0;i<GpuBufferCount;++i) {
+        if(buffers_[i].spanCount()!=1)return kIOReturnUnsupported;
+        ranges[i]={kIovas[i],i==GpuBufferCount-1?base+ProbePage*0x1000:buffers_[i].spans()[0].physical,kBytes[i],i?3u:5u,0,2};
+    }
+    const ArmSmmu4KLiveArena *live=smmu_.arena();
+    ArmSmmu4KConfig config=live->config;
+    config.table_physical=base;
+    ArmSmmu4KResult result{};
+    const ArmSmmu4KStatus built=ArmSmmu4KBuild(&config,ranges,GpuBufferCount,reinterpret_cast<uint64_t *>(cpu),TablePagesProbe,&result);
+    out->status=built;out->input_bits=config.input_bits;
+    if(built!=ArmSmmu4KSuccess)return kIOReturnUnsupported;
+    IOReturn status=NativeAdrenoMaintainOwnedPages(cpu,ProbeBytes,NativeAdrenoCleanInvalidate);
+    if(status)return status;
+    out->root_physical=result.root_physical;out->table_pages=uint32_t(result.table_pages);out->start_level=result.start_level;
+    out->mair=result.mair;
+    NativeAdrenoSmmuContext &smmu=smmu_;
+    out->live_root_physical=smmu.stateHandle()->tables.root_physical;out->live_mair=smmu.stateHandle()->tables.mair;
+    out->ring_leaf=leafOf(cpu,base,TablePagesProbe,result.root_physical,result.start_level,config.input_bits,GpuRingIova);
+    if(tables_.spanCount()==1 && tables_.mapping())
+        out->live_ring_leaf=leafOf(static_cast<const uint8_t *>(tables_.mapping()),tables_.spans()[0].physical,TablePages,
+            out->live_root_physical,result.start_level,config.input_bits,GpuRingIova);
+    out->probe_physical=base+ProbePage*0x1000;
+    out->probe=reinterpret_cast<volatile uint32_t *>(cpu+ProbePage*0x1000);
+    out->scratch=static_cast<volatile uint32_t *>(buffers_[GpuBufferCount-1].mapping());
+    return kIOReturnSuccess;
+}
 static NativeAdrenoGpuContext *board_gpu_context;
+extern "C" IOReturn NativeAdrenoGpuContextTableProbe(NativeAdrenoGpuTableProbe *out)
+{
+    if(!out)return kIOReturnBadArgument;
+    if(!board_gpu_context)return kIOReturnNotReady;
+    return board_gpu_context->tableProbe(out);
+}
