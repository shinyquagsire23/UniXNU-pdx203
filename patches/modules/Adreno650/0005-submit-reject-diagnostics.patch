+ * refused, see native_adreno_submit_core_reject), [2] buffer index, [3] buffer count, [4]/[5] handle low/high, [6] iova low,
+ * [7] bytes, [8] status, [9] pid. */
+extern "C" {volatile uint32_t native_adreno_submit_reject[10];}
+static IOReturn noteSubmitReject(uint32_t check,uint32_t index,uint32_t count,uint64_t handle,uint64_t iova,uint64_t bytes,IOReturn status)
