From 0e73eed931c75bac01a51982e32d766c958a52bf Mon Sep 17 00:00:00 2001
From: shinyquagsire23 <mtinc2@gmail.com>
Date: Sun, 1 Nov 2026 17:11:16 -0700
Subject: [PATCH 1/4] tests: host GPU service passes bringUp its (slot, stream)
 routes

The host simulator still passed parallel slot and SID arrays after bringUp took ArmSmmu4KStream
routes, so Turnip's host check (and the plugin's recorded replay) could not build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Wby9vE95hj6m7p14a2x9aY
---
 tests/hostsim/host_gpu_service.cpp | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/tests/hostsim/host_gpu_service.cpp b/tests/hostsim/host_gpu_service.cpp
index de8e1a0..e8952dd 100644
--- a/tests/hostsim/host_gpu_service.cpp
+++ b/tests/hostsim/host_gpu_service.cpp
@@ -92,9 +92,8 @@ bool build() {
     static const ArmSmmu4KIo io{nullptr,kSmmuBytes,sread32,sread64,swrite32,swrite64,sbarrier};
     context=new NativeAdrenoGpuContext;
     NativeAdrenoGmuContextReport report;
-    const unsigned slots[2]={2,3};
-    const uint16_t sids[2]={0,1};
-    const IOReturn up=context->bringUp(&io,1,2,slots,sids,nullptr,&report);
+    const ArmSmmu4KStream routes[2]={{2,0},{3,1}};   // (SMR slot, stream ID), as bringUp takes them since the route change
+    const IOReturn up=context->bringUp(&io,1,2,routes,2,nullptr,&report);
     if(up!=kIOReturnSuccess) {std::fprintf(stderr,"host gpu: context bring-up failed %d at step %u\n",up,report.step);return false;}
     const NativeAdrenoMemory &ringmem=context->buffer(1),&memory=context->buffer(2);
     memptrs=static_cast<volatile uint32_t *>(memory.mapping());
-- 
