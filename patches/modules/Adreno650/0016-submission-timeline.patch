+static size_t packet(uint32_t *words,size_t at,uint32_t opcode,const uint32_t *payload,uint32_t count);
+/* pdx203 submission timeline, over the user submissions retired since the GPU heartbeat last took it (GpuProbe.cpp GPUTL): [0] count,
+ * [1] GPU us summed (start to end stamp), [2] largest, [3] host us from the WPTR write to the first wait that saw the fence, summed,
+ * [4] largest, [5] GPU idle us before the submission (its start stamp less the previous submission's end stamp), summed, [6] count of
+ * those, [7] submissions without a usable stamp pair. */
+extern "C" {volatile uint64_t native_adreno_ring_timeline[8];}
+uint64_t NativeAdrenoRing::hostNow()
+{
+#ifdef KERNEL
+    uint64_t ns=0;absolutetime_to_nanoseconds(mach_absolute_time(),&ns);return ns/1000;
+#else
+    return 0;
+#endif
+}
+size_t NativeAdrenoRing::stampWords(uint32_t *words,size_t at,uint32_t seqno,uint32_t half) const
+{
+    const uint64_t base=fence_bytes_>=RingStampOffset+RingStampSlots*16?fence_iova_+RingStampOffset+(seqno%RingStampSlots)*16:fence_iova_+16;
+    const uint64_t address=base+half;
+    const uint32_t payload[4]={RingA6xxRbDoneTs|RingEventTimestamp,(uint32_t)address,(uint32_t)(address>>32),0};
+    return at?packet(words,at,RingFenceOpcode,payload,4):packet(words,0,RingFenceOpcode,payload,4);
+}
+void NativeAdrenoRing::noteRetired(uint32_t value)
+{
+    if(!fence_ || fence_bytes_<RingStampOffset+RingStampSlots*16)return;
+    const uint64_t now=hostNow();
+    if(value-timeline_.seen>RingStampSlots)timeline_.seen=value-RingStampSlots;
+    while(timeline_.seen!=value) {
+        const uint32_t seq=++timeline_.seen,slot=seq%RingStampSlots;
+        const uint64_t submitted=timeline_.submitted[slot];
+        timeline_.submitted[slot]=0;
+        if(!submitted)continue;   /* a kernel submission: no stamps */
+        const volatile uint32_t *w=fence_+(RingStampOffset+slot*16)/4;
+        const uint64_t start=(uint64_t)w[1]<<32|w[0],end=(uint64_t)w[3]<<32|w[2];
+        volatile uint64_t *t=native_adreno_ring_timeline;
+        const uint64_t lat=now>submitted?now-submitted:0;
+        t[3]=t[3]+lat;if(lat>t[4])t[4]=lat;
+        if(!(end>start && end-start<19200000ull)) {t[7]=t[7]+1;timeline_.lastEnd=0;continue;}
+        const uint64_t gpu=(end-start)*10/192;
+        t[0]=t[0]+1;t[1]=t[1]+gpu;if(gpu>t[2])t[2]=gpu;
+        if(timeline_.lastEnd && start>timeline_.lastEnd && start-timeline_.lastEnd<19200000ull) {t[5]=t[5]+(start-timeline_.lastEnd)*10/192;t[6]=t[6]+1;}
+        timeline_.lastEnd=end;
+    }
 }
