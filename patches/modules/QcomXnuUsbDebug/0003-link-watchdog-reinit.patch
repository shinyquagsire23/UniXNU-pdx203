+/* Link watchdog. dwc3_recover() only clears the event bookkeeping, it is capped at 64 per boot, and the worker thread used to
+ * exit at the first IO_FAILED, so a link that left the bus (a cable pulled or bumped, a host port reset, a stuck endpoint)
+ * stayed gone until the next boot: observed 2026-11-05 three times while the phone kept running, once coming back for four
+ * seconds and then never again. When the controller has gone unconfigured (or failed) for eight seconds, restart it from
+ * scratch: a soft disconnect, dwc3_init's core soft reset and full configuration, and RUN_STOP again, at most once every
+ * eight seconds. A host that is still attached sees the device leave and come back and enumerates it again; with no host
+ * the restart is a few register writes. The PHY lease, VBUS override and DMA domain from qcom_usb_debug_init stay valid. */
+static uint32_t usb_reinits;
+static uint64_t usb_unconfigured_since, usb_stalled_since, usb_last_reinit;
+static int reinit_owned(uint32_t reason)
+{
+    struct dwc3_platform platform;
+    char text[96], *p;
+    int ret;
+    if (native.core_initialized) (void)dwc3_stop(native.core);
+    bytes_zero(&platform, sizeof(platform));
+    platform.read32 = core_read; platform.write32 = core_write;
+    platform.delay_us = delay_us; platform.dma_sync = dma_sync;
+    platform.barrier = barrier; platform.trace = core_trace;
+    ret = dwc3_init(usb_context, sizeof(usb_context), &platform, &usb_identity, usb_dma,
+                    native.status.dma_iova, sizeof(usb_dma));
+    if (!ret) ret = dwc3_start(native.core);
+    usb_reinits++;
+    usb_last_reinit = counter();
+    usb_unconfigured_since = usb_stalled_since = 0;
+    p = append_text(text, "\nQCOM USB REINIT n=");
+    p = append_decimal(p, usb_reinits);
+    p = append_text(p, reason == 1 ? " after IO_FAILED" : reason == 2 ? " after 8 s stalled" : reason == 3 ? " after cable plug-in" :
+                       " after 8 s unconfigured");
+    p = append_text(p, " recoveries=");
+    p = append_decimal(p, usb_recoveries);
+    p = append_text(p, ret ? " FAILED\n" : " ok\n");
+    (void)backlog_write(text, (size_t)(p - text));
+    if (ret) return 0;
+    native.status.io_failed = 0;
+    native.status.core_result = 0;
+    native.status.error = 0;
+    native.status.phase = QCOM_USB_DEBUG_ACTIVE;
+    usb_recoveries = 0;
+    return 1;
+}
+/* The board's view of the USB cable (package/Pdx203Battery.cpp, from the charger): -1 unknown, 0 out, 1 in with the charger's port
+ * detection still on D+/D-, 2 in. Absent on boards without it; then only the timers below decide. */
+extern volatile int32_t pdx203_usb_cable __attribute__((weak_import));
+static void link_watchdog(void)
+{
+    uint64_t flags, now, limit = native.status.counter_frequency * 8u;
+    uint32_t failed;
+    if (!native.core_initialized || !limit || !acquire(&flags)) return;
+    now = counter();
+    /* Cable out: stop the controller, which takes the pull-up off (dwc3-qcom's vbus_session(0)), and leave it stopped. Cable back and
+     * the charger's detection done: restart it from scratch, so the host sees a fresh device after BC1.2 rather than during it. */
+    if (&pdx203_usb_cable) {
+        const int32_t cable = pdx203_usb_cable;
+        if (cable == 0 && !usb_cable_off) {
+            static const char text[] = "\nQCOM USB cable out: controller stopped\n";
+            if (native.core) (void)dwc3_stop(native.core);
+            usb_cable_off = 1;
+            usb_unconfigured_since = usb_stalled_since = 0;
+            (void)backlog_write(text, sizeof(text) - 1);
+        } else if (usb_cable_off && cable == 2) {
+            usb_cable_off = 0;
+            (void)reinit_owned(3);
+        }
+        if (usb_cable_off || cable == 1) {release(flags); return;}
+    }
+    failed = native.status.phase == QCOM_USB_DEBUG_IO_FAILED;
+    if (!failed && dwc3_configured(native.core)) {
+        /* Configured but not draining: the transmit ring has stayed over half full for eight seconds, so no IN transfer is
+         * completing (a host that dropped the device without a bus reset, or an endpoint the controller stopped serving). */
+        usb_unconfigured_since = 0;
+        if (dwc3_queued(native.core) < DWC3_TX_BYTES / 2u) usb_stalled_since = 0;
+        else if (!usb_stalled_since) usb_stalled_since = now;
+        else if (now - usb_stalled_since >= limit && now - usb_last_reinit >= limit) (void)reinit_owned(2);
+    } else {
+        if (!usb_unconfigured_since) usb_unconfigured_since = now;
+        if ((failed || now - usb_unconfigured_since >= limit) && now - usb_last_reinit >= limit)
+            (void)reinit_owned(failed);
+    }
+    release(flags);
+}
 void qcom_usb_debug_poll(void)
 {
     uint64_t flags;
@@ -1458,6 +1542,7 @@ void qcom_usb_debug_poll(void)
     uint32_t generation = 0;
