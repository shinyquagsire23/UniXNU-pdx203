+    case SXNU_CONTROL_VERB_KEY: {
+        char why[40] = "";
+        int rc;
+        if (!&qcom_usb_debug_board_input)
+            reply_bytes = control_reply_reboot(reply, sizeof(reply), frame, "ERR", "noinput");
