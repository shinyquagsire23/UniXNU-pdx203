+/* Free room in the transmit ring now (0 when USB is not active): a SHOTNEXT chunk is sized to it, as a reply that does not fit is dropped. */
+static size_t control_tx_room(void)
+{
+    uint64_t flags;
+    size_t room = 0;
+    if (!acquire(&flags)) return 0;
+    if (native.status.phase == QCOM_USB_DEBUG_ACTIVE) room = DWC3_TX_BYTES - dwc3_queued(native.core);
+    release(flags);
+    return room;
