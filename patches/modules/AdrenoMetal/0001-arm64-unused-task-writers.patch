From: pdx203 <noreply@anthropic.com>
Subject: plugin: keep the arm64e-only task writers from failing the arm64 build

writeTask() and patchFramebufferBranch() are called only under
#if defined(__arm64e__) (the iOS 27 target); the arm64 iOS 17 build
(pdx203's iPad7,1 21H461 userland) stops on -Werror,-Wunused-function.

diff --git a/NativeAdrenoMetalPlugin.mm b/NativeAdrenoMetalPlugin.mm
index 415e9c8..74ae3d5 100644
--- a/NativeAdrenoMetalPlugin.mm
+++ b/NativeAdrenoMetalPlugin.mm
@@ -81,7 +81,7 @@ static bool readTask(uintptr_t address, void *out, size_t size) {
     vm_size_t got = 0;
     return vm_read_overwrite(mach_task_self(), address, size, (vm_address_t) out, &got) == KERN_SUCCESS && got == size;
 }
-static bool writeTask(uintptr_t address, const void *data, size_t size) {
+__attribute__((unused)) static bool writeTask(uintptr_t address, const void *data, size_t size) {
     return vm_write(mach_task_self(), address, (vm_offset_t) data, (mach_msg_type_number_t) size) == KERN_SUCCESS;
 }
 // EXPERIMENT (second report onward): this display path takes plain 8-bit BGRA only, so tell the render server's display that it has neither the deep
@@ -96,7 +96,7 @@ static bool bootArgSet(const char *key) {
     size_t size = sizeof args - 1;
     return sysctlbyname("kern.bootargs", args, &size, nullptr, 0) == 0 && strstr(args, key);
 }
-static unsigned patchFramebufferBranch(uintptr_t slide) {
+__attribute__((unused)) static unsigned patchFramebufferBranch(uintptr_t slide) {
     const uintptr_t site = 0x184461928 + slide;
     uint32_t word = 0;
     if (!readTask(site, &word, sizeof word)) return 0x6E40;
