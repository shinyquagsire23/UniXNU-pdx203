From: pdx203 <noreply@anthropic.com>
Subject: frontend: texture log for one named app process

The texture log (texture-log, render server only, through the log-gpu switch) also runs in the process
named by /private/var/ngpu/debug/app-texture-log, writing with NSLog so the board's os_log forwarder sees it:
every texture a game made sampled magenta (Dusk, 2026-11-06). An app logs its first 300 lines, then every 100th.

diff --git a/NativeBridgeMetalFrontend.mm b/NativeBridgeMetalFrontend.mm
--- a/NativeBridgeMetalFrontend.mm
+++ b/NativeBridgeMetalFrontend.mm
@@ -583,22 +583,31 @@
 // Diagnostic, render server only, while /private/var/ngpu/debug/texture-log exists when it starts: every texture made over an
 // IOSurface or a no-copy buffer is logged "native-metal: texture-log ..." with the surface's own size, rows, format and planes
 // next to the texture's, to tell which memory and which shape a garbled layer was drawn from.
-static const bool gLogTextures=isRenderServer() && access("/private/var/ngpu/debug/texture-log",F_OK)==0;
+// pdx203: also any process named by /private/var/ngpu/debug/app-texture-log (its first line, e.g. "Dusk"), whose lines go to os_log with
+// NSLog (no log-gpu boot argument needed): a game's textures all sampled magenta (2026-11-06).
+static bool appTextureLog() {
+ FILE *f=fopen("/private/var/ngpu/debug/app-texture-log","r");if(!f)return false;
+ char name[64]={0};const bool read=fgets(name,sizeof name,f)!=nullptr;fclose(f);if(!read)return false;
+ name[strcspn(name,"\r\n ")]=0;return name[0] && !strcmp(name,getprogname());
+}
+static const bool gAppTextureLog=!isRenderServer() && appTextureLog();
+static const bool gLogTextures=(isRenderServer() && access("/private/var/ngpu/debug/texture-log",F_OK)==0) || gAppTextureLog;
+#define TLOG(...) do{if(gAppTextureLog)NSLog(__VA_ARGS__);else GLOG(__VA_ARGS__);}while(0)
 static std::atomic<uint64_t> gTexturesLogged;
-// The first 2000 texture-log lines, then every 100th: the uploads run every frame.
-static bool textureLogTurn() {const uint64_t n=++gTexturesLogged;return n<=2000 || n%100==0;}
+// The first 2000 texture-log lines (an app's 300), then every 100th: the uploads run every frame.
+static bool textureLogTurn() {const uint64_t n=++gTexturesLogged;return n<=(gAppTextureLog?300:2000) || n%100==0;}
 static void logTexture(const char *kind,MTLTextureDescriptor *d,IOSurfaceRef surface,NSUInteger plane,const void *bytes,
                        NSUInteger offset,NSUInteger row,bool made) {
  if(!textureLogTurn())return;
  const uint64_t n=gTexturesLogged.load();
  if(surface)
-  GLOG(@"native-metal: texture-log %llu %s %s desc %lux%lu fmt %lu rot %lu | surface id %u %zux%zu rows %zu fmt %08x planes %zu "
+  TLOG(@"native-metal: texture-log %llu %s %s desc %lux%lu fmt %lu rot %lu | surface id %u %zux%zu rows %zu fmt %08x planes %zu "
         @"plane %lu alloc %zu | offset %lu rows %lu",(unsigned long long)n,kind,made?"made":"REFUSED",(unsigned long)d.width,
         (unsigned long)d.height,(unsigned long)d.pixelFormat,(unsigned long)textureRotation(d),IOSurfaceGetID(surface),
         IOSurfaceGetWidth(surface),IOSurfaceGetHeight(surface),IOSurfaceGetBytesPerRow(surface),IOSurfaceGetPixelFormat(surface),
         IOSurfaceGetPlaneCount(surface),(unsigned long)plane,IOSurfaceGetAllocSize(surface),(unsigned long)offset,(unsigned long)row);
  else
-  GLOG(@"native-metal: texture-log %llu %s %s desc %lux%lu fmt %lu | memory %p offset %lu rows %lu",(unsigned long long)n,kind,
+  TLOG(@"native-metal: texture-log %llu %s %s desc %lux%lu fmt %lu | memory %p offset %lu rows %lu",(unsigned long long)n,kind,
         made?"made":"REFUSED",(unsigned long)d.width,(unsigned long)d.height,(unsigned long)d.pixelFormat,bytes,(unsigned long)offset,
         (unsigned long)row);
 }
@@ -1215,7 +1224,7 @@
