index b56848c..f343347 100644
--- a/NativeBridgeMetalFrontend.mm
+++ b/NativeBridgeMetalFrontend.mm
@@ -175,6 +175,9 @@ static Timed gTimePipeline,gTimeLibrary,gTimeFunction,gTimeEncodeToCommit;
 // Where a frame's time goes, as histograms over power-of-two millisecond buckets (<1, <2, <4 ... <256, more): commit to completion of the
 // command buffers that hold a full-screen pass (a frame's), of every other one, and a frame's encoding (creation to commit).
 static std::atomic<uint64_t> gHistFrameGpu[10],gHistOtherGpu[10],gHistFrameEncode[10];
+// GPU time (us) and count of the command buffers that drew or dispatched: [0]/[1] those holding a full-screen pass, [2]/[3] the rest.
+static std::atomic<uint64_t> gGpuTimes[4];
+extern "C" void NBGpuTimes(uint64_t out[4]) {for(int i=0;i<4;i++)out[i]=gGpuTimes[i].load(std::memory_order_relaxed);}
 static void histAdd(std::atomic<uint64_t> *bins,uint64_t us) {unsigned b=0;const uint64_t ms=us/1000;while(b<9 && ms>=(1ull<<b))++b;bins[b]++;}
 static Timed gTimeCompile;                     // the system compiler's requests (codeGenRequest), the shader cache's misses
 static std::atomic<uint64_t> gCompileCached;   // requests the shader cache answered
@@ -3294,6 +3297,11 @@ static void completed(void *context) {
   {
    const bool frame=commandBuffer->encodedWork.pixels>=2000000;
    histAdd(frame?gHistFrameGpu:gHistOtherGpu,took);
+   if(!commandBuffer.failedLocally && (commandBuffer->encodedWork.draws || commandBuffer->encodedWork.dispatches)) {
+    // the GPU's own time of the work (its timestamps), for the scanout client's report (NBGpuTimes)
+    const double start=nmb_command_buffer_gpu_time(commandBuffer.handle,false),end=nmb_command_buffer_gpu_time(commandBuffer.handle,true);
+    if(start>0 && end>=start){gGpuTimes[frame?0:2]+=(uint64_t)((end-start)*1e6);gGpuTimes[frame?1:3]++;}
+   }
    if(frame)histAdd(gHistFrameEncode,commandBuffer.committedUs-commandBuffer->createdUs);
   }
   gTimeEncodeToCommit.count++;gTimeEncodeToCommit.total+=took;
