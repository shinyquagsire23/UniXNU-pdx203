+; scanout_opaque4: scanout_opaque with four pixels a thread (16-byte loads and stores); p in 16-byte units: width/4, height, source and
+; destination row pitches. Used where both pitches and the width are multiples of 16 bytes.
+;   kernel void scanout_opaque4(device const uint4 *src [[buffer(0)]], device uint4 *dst [[buffer(1)]], constant uint4 &p [[buffer(3)]],
+;                               uint2 gid [[thread_position_in_grid]])
+define void @scanout_opaque4(ptr addrspace(1) noundef readonly "air-buffer-no-alias" %src, ptr addrspace(1) noundef "air-buffer-no-alias" %dst, ptr addrspace(2) noundef readonly align 16 dereferenceable(16) "air-buffer-no-alias" %p, <2 x i32> noundef %gid) local_unnamed_addr #0 {
+entry:
+  %w = load i32, ptr addrspace(2) %p, align 16
+  %ph = getelementptr inbounds i32, ptr addrspace(2) %p, i64 1
+  %h = load i32, ptr addrspace(2) %ph, align 4
+  %pss = getelementptr inbounds i32, ptr addrspace(2) %p, i64 2
+  %ss = load i32, ptr addrspace(2) %pss, align 8
+  %pds = getelementptr inbounds i32, ptr addrspace(2) %p, i64 3
+  %ds = load i32, ptr addrspace(2) %pds, align 4
+  %x = extractelement <2 x i32> %gid, i64 0
+  %y = extractelement <2 x i32> %gid, i64 1
+  %inx = icmp ult i32 %x, %w
+  %iny = icmp ult i32 %y, %h
+  %in = and i1 %inx, %iny
+  br i1 %in, label %body, label %done
+
+body:
+  %x64 = zext i32 %x to i64
+  %y64 = zext i32 %y to i64
+  %ss64 = zext i32 %ss to i64
+  %srow = mul i64 %y64, %ss64
+  %si = add i64 %srow, %x64
+  %sp = getelementptr inbounds <4 x i32>, ptr addrspace(1) %src, i64 %si
+  %v = load <4 x i32>, ptr addrspace(1) %sp, align 16
+  %px = or <4 x i32> %v, <i32 -16777216, i32 -16777216, i32 -16777216, i32 -16777216>
+  %ds64 = zext i32 %ds to i64
+  %drow = mul i64 %y64, %ds64
+  %di = add i64 %drow, %x64
+  %dp = getelementptr inbounds <4 x i32>, ptr addrspace(1) %dst, i64 %di
+  store <4 x i32> %px, ptr addrspace(1) %dp, align 16
+  br label %done
+
+done:
+  ret void
+}
