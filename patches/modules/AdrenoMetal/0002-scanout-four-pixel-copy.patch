 private:
+    // One opaque copy of the frame into the scanout, committed (not waited for): `rows` rows of `width` pixels, four pixels a thread when `wide`.
+    id<MTLCommandBuffer> opaqueCopy(bool wide, id<MTLBuffer> source, uint32_t width, uint32_t rows, size_t pitch, MTLCommandBufferHandler scheduled) {
+        id<MTLCommandBuffer> commands = [queue_ commandBuffer];
+        if (commands && scheduled) [commands addScheduledHandler:scheduled];
+        id<MTLComputeCommandEncoder> encoder = commands ? [commands computeCommandEncoder] : nil;
+        if (!encoder) return nil;
+        const uint32_t unit = wide ? 16 : 4, w = wide ? width / 4 : width;
+        const uint32_t params[4] = {w, rows, (uint32_t)(pitch / unit), (uint32_t)(scanout_.stride / unit)};
+        [encoder setComputePipelineState:wide ? opaque4_ : opaque_];
+        [encoder setBuffer:source offset:0 atIndex:0];
+        [encoder setBuffer:target_ offset:0 atIndex:1];
+        [encoder setBytes:params length:sizeof params atIndex:3];
+        // 16 x 8 threads a group either way: a group covers 16 or 64 pixels of a row
+        [encoder dispatchThreadgroups:MTLSizeMake((w + 15) / 16, (rows + 7) / 8, 1) threadsPerThreadgroup:MTLSizeMake(16, 8, 1)];
+        [encoder endEncoding];
+        [commands commit];
+        return commands;
+    }
+    void note(bool wide, id<MTLCommandBuffer> c, uint64_t beganNs, uint64_t scheduledNs) {
+        const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        if (scheduledNs >= beganNs && scheduledNs <= now) {
+            ++timing_.split; timing_.toScheduledUs += (scheduledNs - beganNs) / 1000; timing_.scheduledToDoneUs += (now - scheduledNs) / 1000;
+        }
+        timing_.hostUs += (now - beganNs) / 1000;
+        const double start = c.GPUStartTime, end = c.GPUEndTime;
+        if (!(start > 0 && end >= start)) {++timing_.untimed; return;}
+        ++timing_.frames[wide]; timing_.gpuUs[wide] += (uint64_t)((end - start) * 1e6 + 0.5);
+    }
+    // The four-pixel kernel's first frame against the surface (the top 64 rows, alpha made opaque); the scanout is device memory, read in words.
+    bool sameAsSurface(const Frame &frame) const {
+        const uint32_t rows = frame.height < 64 ? frame.height : 64;
+        for (uint32_t y = 0; y < rows; ++y) {
+            const volatile uint32_t *a = (const volatile uint32_t *)((const uint8_t *)scanout_.base + (size_t)y * scanout_.stride);
+            const uint32_t *b = (const uint32_t *)((const uint8_t *)frame.base + (size_t)y * frame.stride);
+            for (uint32_t x = 0; x < frame.width; ++x) if (a[x] != (b[x] | 0xff000000u)) return false;
+        }
+        return true;
+    }
+    CopyTiming timing_;
+    id<MTLComputePipelineState> opaque4_ = nil;
+    bool opaque4Failed_ = false;
