++    #[cfg(any(target_os = "macos", target_os = "ios"))]
+     pub(super) unsafe fn of(pointer: NonNull<u8>, length: u64) -> Option<ReadOnlyView> {
+         unsafe extern "C" {
+             /// `<mach/mach_init.h>`: the port of this process's task.
+@@ -174,7 +178,7 @@ impl ReadOnlyView {
