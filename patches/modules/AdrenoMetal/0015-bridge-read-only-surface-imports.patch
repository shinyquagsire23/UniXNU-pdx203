+ /// (the module docs).
+-pub(super) const VIEWS_DROP_WRITES: bool = cfg!(target_os = "macos");
++///
++/// pdx203 (bridge 0038): iOS too. NativeAdreno's import pins memory it cannot pin for writing for
++/// reading only and maps it into the GPU read-only, which also spares the CPU cache invalidation
++/// a writable import costs when the GPU lets it go (a render server's per-frame IOSurface imports).
++pub(super) const VIEWS_DROP_WRITES: bool = cfg!(any(target_os = "macos", target_os = "ios"));
+ 
+ /// A read-only view of `length` bytes of the caller's pages, mapped by the runtime and unmapped
+ /// as this goes: after the memory imported from it is freed (`memory.rs`'s `Block`).
+@@ -112,7 +116,7 @@ impl ReadOnlyView {
