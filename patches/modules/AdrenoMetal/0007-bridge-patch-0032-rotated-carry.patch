+ /// dispatch's workgroups.
+ struct Move {
+@@ -154,6 +168,9 @@
+     apart: bool,
+     kernel: OwnedKernel,
+     sets: OwnedSets,
++    /// The image's last standing at an encoder's end, carried across command buffers
++    /// ([`LastStanding`]); `None` where the last encoder that used it did not end holding it.
++    pub(super) lasting: std::sync::Mutex<Option<LastStanding>>,
+ }
+ 
+ impl RotatedCopies {
+@@ -287,6 +304,7 @@
+             apart: loads_apart(rotation, [width, height]),
+             kernel,
+             sets,
++            lasting: std::sync::Mutex::new(None),
+         })
+     }
+ 
+@@ -362,7 +380,18 @@
+                     &self.regions,
+                 );
+             } else {
+-                shadow::record_back(device, command_buffer, (staging, bytes), back);
++                // pdx203: the staged plane goes back as one copy of its whole span, the bytes
++                // between rows included, instead of a copy of each row (`back`, 2560 regions
++                // for a landscape framebuffer, each its own blit on Turnip). Those bytes are the
++                // rows' padding, which a framebuffer-only texture's plane gives no other meaning:
++                // the staging buffer holds them as the copy in read them, or as the kernel wrote.
++                let _ = back;
++                let whole = vk::BufferCopy {
++                    src_offset: staging.into.dst_offset,
++                    dst_offset: staging.into.src_offset,
++                    size: staging.into.size,
++                };
++                device.cmd_copy_buffer(command_buffer, staging.raw(), bytes, &[whole]);
+             }
+         }
+     }
