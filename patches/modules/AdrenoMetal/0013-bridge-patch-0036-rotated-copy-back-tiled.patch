+index 6f8bc82..326fb94 100644
+--- a/crates/metal2vulkan-runtime/src/owned_kernel.rs
++++ b/crates/metal2vulkan-runtime/src/owned_kernel.rs
+@@ -1283,95 +1283,174 @@ impl OwnedBinds {
+ pub(super) const ROTATED_COPY_BACK_PUSH_BYTES: u32 = 40;
+ 
+ /// pdx203 (bridge 0034): [`OwnedModule::RotatedCopyBack`]'s SPIR-V, `glslc --target-env=vulkan1.1 -O`
+-/// of this GLSL (local size 64 x 1 x 1; invocation `(x, y)` of the stored extent):
++/// of this GLSL. pdx203 (bridge 0036): a workgroup of 32 x 8 invocations turns one 32 x 32 block of the
++/// stored frame: it fetches the block's source texels (a 32 x 32 block of the frame image, the store map
++/// being a quarter turn or a mirror) along the image's rows into shared memory, each texel at the stored
++/// position the inverse of the map (its transpose) gives, then stores the block along the plane's rows.
++/// Bridge 0034's kernel fetched one texel per invocation down an image column, a cache line a texel:
++/// ~10 ms of an Adreno 650 per 2560 x 1096 copy back.
+ ///
+ /// ```glsl
+ /// #version 450
+ /// #extension GL_EXT_samplerless_texture_functions : require
+-/// layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
++/// layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
+ /// layout(set = 0, binding = 0) uniform utexture2D frame;
+ /// layout(set = 0, binding = 1, std430) writeonly buffer Bytes { uint words[]; } bytes;
+ /// layout(push_constant, std430) uniform Shape {
+ ///     int m00; int m01; int m02; int m10; int m11; int m12;
+ ///     uint width; uint height; uint row_words; uint first_word;
+ /// } shape;
++/// shared uint tile[32][33];
+ /// void main() {
+-///     uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
+-///     if (x >= shape.width || y >= shape.height) return;
+-///     ivec2 p = ivec2(int(x), int(y));
+-///     ivec2 source = ivec2(shape.m00 * p.x + shape.m01 * p.y + shape.m02,
+-///                          shape.m10 * p.x + shape.m11 * p.y + shape.m12);
+-///     bytes.words[shape.first_word + y * shape.row_words + x] = texelFetch(frame, source, 0).r;
++///     ivec2 block = ivec2(gl_WorkGroupID.xy) * 32;
++///     ivec2 l = ivec2(gl_LocalInvocationID.xy);
++///     ivec2 a = ivec2(shape.m00 * block.x + shape.m01 * block.y + shape.m02,
++///                     shape.m10 * block.x + shape.m11 * block.y + shape.m12);
++///     ivec2 origin = min(a, a + 31 * ivec2(shape.m00 + shape.m01, shape.m10 + shape.m11));
++///     for (int k = 0; k < 32; k += 8) {
++///         ivec2 q = origin + ivec2(l.x, l.y + k);
++///         ivec2 d = q - ivec2(shape.m02, shape.m12);
++///         ivec2 p = ivec2(shape.m00 * d.x + shape.m10 * d.y, shape.m01 * d.x + shape.m11 * d.y);
++///         if (p.x >= 0 && p.y >= 0 && uint(p.x) < shape.width && uint(p.y) < shape.height) {
++///             ivec2 s = p - block;
++///             tile[s.y][s.x] = texelFetch(frame, q, 0).r;
++///         }
++///     }
++///     barrier();
++///     for (int k = 0; k < 32; k += 8) {
++///         ivec2 p = block + ivec2(l.x, l.y + k);
++///         if (uint(p.x) < shape.width && uint(p.y) < shape.height) {
++///             bytes.words[shape.first_word + uint(p.y) * shape.row_words + uint(p.x)] = tile[l.y + k][l.x];
++///         }
++///     }
+ /// }
+ /// ```
+ pub(super) const ROTATED_COPY_BACK_SPIRV: &[u32] = &[
