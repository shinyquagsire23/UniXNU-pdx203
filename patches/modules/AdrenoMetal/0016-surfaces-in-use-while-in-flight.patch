-  if(all || CFGetRetainCount(it->second.surface)<=1){gone.push_back(it->second.buffer);it=gHeldImports.erase(it);}
+  if(all || CFGetRetainCount(it->second.surface)<=1){if(!all)gHeldPruned++;gone.push_back(it->second.buffer);it=gHeldImports.erase(it);}
   else ++it;
  }
 }
