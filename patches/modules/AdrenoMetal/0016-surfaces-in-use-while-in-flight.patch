+static std::atomic<uint32_t> gUseLive,gUseEnded,gUseMax;static std::atomic<uint64_t> gUseTotal;
+static void noteUseEnded(uint64_t ms) {
+ gUseLive--;gUseEnded++;gUseTotal+=ms;uint32_t m=gUseMax.load();while(ms>m && !gUseMax.compare_exchange_weak(m,(uint32_t)ms)){}
