 static NSUInteger gSurfaceImportsPruned=64;     // the table size at which dead associations are next pruned
+// pdx203: held imports let go because only the import still retained the surface (under gSurfaceImportLock).
+static uint32_t gHeldPruned;
+// pdx203: at most every 2 s, at a surface import of 1 MiB or more, a line for the kernel's log (GPUNOTE, through Turnip's tu_darwin_note,
+// kind 3 text): such imports made since the last line, of them writable, held imports let go, and how long the surfaces of 1 MiB or more
+// that command buffers counted in use stayed counted (countSurfacesInUse). Steady drawing makes no such import, so no line. Under
+// gSurfaceImportLock.
+struct ImportNote {uint32_t made,writable;uint64_t since;char text[124];bool pending;};
+static ImportNote gImportNote;
+static void noteBigImport(size_t bytes,bool readOnly) {
+ if(bytes<(1u<<20))return;
+ ImportNote &c=gImportNote;
+ c.made++;if(!readOnly)c.writable++;
+ const uint64_t now=clock_gettime_nsec_np(CLOCK_UPTIME_RAW)/1000000;
+ if(!c.since)c.since=now;
+ if(now-c.since<2000 || c.pending)return;
+ const uint32_t ended=gUseEnded.exchange(0);const uint64_t total=gUseTotal.exchange(0);
+ snprintf(c.text,sizeof c.text,"SURF %llums imports %u rw %u let-go %u | in use: %u ended avg %llu max %u ms, %u live",
+  (unsigned long long)(now-c.since),c.made,c.writable,gHeldPruned,ended,(unsigned long long)(ended?total/ended:0),gUseMax.exchange(0),
+  gUseLive.load());
+ c.pending=true;c.made=c.writable=0;gHeldPruned=0;c.since=now;
+}
+// Sends the line noteBigImport left, outside gSurfaceImportLock.
+static void sendImportNote() {
+ char text[124];
+ {std::lock_guard<std::mutex> lock(gSurfaceImportLock);if(!gImportNote.pending)return;memcpy(text,gImportNote.text,sizeof text);gImportNote.pending=false;}
+ static bool (*note)(uint32_t,const uint32_t *,uint32_t);static dispatch_once_t once;
+ dispatch_once(&once,^{
+  if(gLoaderPath.empty())return;
+  void *t=dlopen(gLoaderPath.c_str(),RTLD_NOW|RTLD_NOLOAD);
+  if(t){note=(bool (*)(uint32_t,const uint32_t *,uint32_t))dlsym(t,"tu_darwin_note");dlclose(t);}
+ });
+ if(!note)return;
+ uint32_t words[30]={};const size_t n=strnlen(text,120);memcpy(words,text,n);
+ (void)note(3,words,(uint32_t)((n+3)/4));
+}
