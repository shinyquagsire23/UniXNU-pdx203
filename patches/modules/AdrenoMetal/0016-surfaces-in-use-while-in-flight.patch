+// pdx203: each distinct surface the command buffer's textures lie over is counted in use until it completes (gCountsSurfaceUse).
+- (void)countSurfacesInUse {
+ if(!gCountsSurfaceUse || !_surfaces.count || self.surfacesInUse)return;
+ NSMutableArray *counted=[NSMutableArray arrayWithCapacity:_surfaces.count];
+ for(NBTexture *texture in _surfaces) {
+  IOSurfaceRef surface=texture.surface;if(!surface)continue;
+  id object=(__bridge id)surface;if([counted indexOfObjectIdenticalTo:object]!=NSNotFound)continue;
+  IOSurfaceIncrementUseCount(surface);[counted addObject:object];
+  if(IOSurfaceGetAllocSize(surface)>=(1u<<20))gUseLive++;
+ }
+ self.surfacesInUse=counted;
+}
+- (void)endSurfacesInUse {
+ NSArray *counted;@synchronized(self){counted=self.surfacesInUse;self.surfacesInUse=@[];}
+ const uint64_t lifeMs=(nowUs()-self.committedUs)/1000;
+ for(id object in counted) {
+  IOSurfaceRef surface=(__bridge IOSurfaceRef)object;
+  if(IOSurfaceGetAllocSize(surface)>=(1u<<20))noteUseEnded(lifeMs);
+  IOSurfaceDecrementUseCount(surface);
+ }
+}
