++/// pdx203 (bridge 0034): a copy back as one dispatch of `OwnedModule::RotatedCopyBack`: the frame
++/// image's `R32_UINT` view fetched at the turned position of each texel of the stored frame and
++/// stored straight into the plane's bytes, in order, instead of the image copied into the tight
++/// buffer, turned by the gather kernel into the staging buffer, and that copied into the plane
++/// (~15 ms of an Adreno 650's frame in landscape, against ~1.5 ms for the frame's own passes). Its
++/// set binds the plane's `VkBuffer` as it lay when the texture was made; a copy back whose
++/// `VkBuffer` is another (a rebind moved the plane's pages) takes the copies as before. It writes
++/// the plane's texels and no other byte.
++struct FastBack {
++    kernel: OwnedKernel,
++    binds: OwnedBinds,
++    bytes: vk::Buffer,
++    shape: [u8; ROTATED_COPY_BACK_PUSH_BYTES as usize],
++    groups: [u32; 2],
++}
++
++impl FastBack {
++    /// The dispatch for `frame` turned into the plane whose first texel lies at byte `first` of
++    /// `bytes`, reading the frame image through `view`; `None` where it does not fit (a texel of
++    /// another width, a range past `maxStorageBufferRange`, a dispatch past the group counts) or
++    /// the device makes no kernel or binds, which leaves the copies.
++    fn new(device: &Device, frame: &Frame, (view, bytes): (vk::ImageView, vk::Buffer), first: u64) -> Option<FastBack> {
++        if frame.texel_bytes != 4 || bytes == vk::Buffer::null() || !first.is_multiple_of(4) {
++            return None;
++        }
++        let limits = &device.properties().description.limits;
++        let [width, height] = frame.extent;
++        let [stored_width, stored_height] = stored_extent(frame.rotation, [width, height]);
++        let align = limits.min_storage_buffer_offset_alignment.max(4);
++        let offset = first - first % align;
++        let range = (first - offset) + frame.span.next_multiple_of(4);
++        let groups = [stored_width.div_ceil(64), stored_height];
++        if range > u64::from(limits.max_storage_buffer_range)
++            || groups[0] > limits.max_compute_work_group_count[0]
++            || groups[1] > limits.max_compute_work_group_count[1]
++            || !frame.row_pitch.is_multiple_of(4)
++        {
++            return None;
++        }
++        let row_words = u32::try_from(frame.row_pitch / 4).ok()?;
++        let first_word = u32::try_from((first - offset) / 4).ok()?;
++        let map = source_map(frame.rotation, [width, height], Turn::Store);
++        let mut shape = [0u8; ROTATED_COPY_BACK_PUSH_BYTES as usize];
++        let words: [u32; 10] = [
++            map[0] as u32,
++            map[1] as u32,
++            map[2] as u32,
++            map[3] as u32,
++            map[4] as u32,
++            map[5] as u32,
++            stored_width,
++            stored_height,
++            row_words,
++            first_word,
++        ];
++        for (i, word) in words.iter().enumerate() {
++            shape[4 * i..4 * i + 4].copy_from_slice(&word.to_le_bytes());
++        }
++        let kernel = device.owned_kernel(OwnedModule::RotatedCopyBack).ok()?;
++        let set = OwnedSet {
++            images: vec![view],
++            storage_images: Vec::new(),
++            buffers: vec![(bytes, offset, range)],
++        };
++        let binds = OwnedBinds::new(device, &kernel, &[set]).ok()?;
++        Some(FastBack {
++            kernel,
++            binds,
++            bytes,
++            shape,
++            groups,
++        })
++    }
