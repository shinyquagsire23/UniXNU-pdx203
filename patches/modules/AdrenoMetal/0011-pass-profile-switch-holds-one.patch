From: pdx203 <noreply@anthropic.com>
Subject: plugin: the pass profile is on only where debug/pass-profile holds 1

The add-on installs files under /private/var/ngpu and removes none, so a pass-profile shipped once kept the render
server profiling on every later boot. It is now on only where the file begins with 1; an empty one turns it off.

diff --git a/NativeAdrenoMetalPlugin.mm b/NativeAdrenoMetalPlugin.mm
--- a/NativeAdrenoMetalPlugin.mm
+++ b/NativeAdrenoMetalPlugin.mm
@@ -92,6 +92,12 @@
 // tablet drew light blue blocks. Here the byte stays 1 and only this branch is made a NOP, so the framebuffer is chosen as on a real device and
 // nothing else changes. Marks 0x6E40 unreadable, 0x6E41 other instruction, 0x6E42 patched, 0x6E50|stage failures.
 extern "C" void NBDiagLatch(void) __attribute__((weak_import));
+// pdx203: a switch under /private/var/ngpu/debug is on where its file's first character is '1'.
+static bool debugSwitchOn(const char *name) {
+    char path[128];snprintf(path, sizeof path, "/private/var/ngpu/debug/%s", name);
+    FILE *f = fopen(path, "r");if (!f) return false;
+    const int c = fgetc(f);fclose(f);return c == '1';
+}
 static bool bootArgSet(const char *key) {
     char args[1100] = {};
     size_t size = sizeof args - 1;
@@ -244,11 +250,13 @@
         // submission ring, the runtime's stage ring, and in the render server the status and telemetry lines. Without it none of them runs.
         if (bootArgSet("sheng-diag=1") || bootArgSet("sheng-gpu-trace=1")) setenv("SHENG_DIAG", "1", 1);
         else unsetenv("SHENG_DIAG");
-        // The render server's pass profile, while /private/var/ngpu/debug/pass-profile exists (an add-on can ship it): its passes are stamped
+        // The render server's pass profile, while /private/var/ngpu/debug/pass-profile holds 1 (an add-on can ship it): its passes are stamped
         // (Turnip and the runtime read SHENG_DIAG at their first pass and command buffer) with the frontend's own diagnostics settled off
-        // first; NBPassPoll logs them (NativeBridgeMetalFrontend.mm). Off, nothing is stamped or logged.
-        if (!getenv("SHENG_DIAG") && !strcmp(getprogname(), "backboardd") && NBDiagLatch &&
-            access("/private/var/ngpu/debug/pass-profile", F_OK) == 0) {NBDiagLatch(); setenv("SHENG_DIAG", "1", 1);}
+        // first; NBPassPoll logs them (NativeBridgeMetalFrontend.mm). Off, nothing is stamped or logged. pdx203: a 1, not the file alone, as
+        // the add-on removes no file it installed (an empty one shipped later turns a profile shipped before off).
+        if (!getenv("SHENG_DIAG") && !strcmp(getprogname(), "backboardd") && NBDiagLatch && debugSwitchOn("pass-profile")) {
+            NBDiagLatch(); setenv("SHENG_DIAG", "1", 1);
+        }
         if (bootArgSet("sheng-gpu-trace=1")) setenv("SHENG_GPU_TRACE", "1", 1);
         else unsetenv("SHENG_GPU_TRACE");
         if (bootArgSet("sheng-wallpaper-freeze=1")) setenv("NATIVE_METAL_FREEZE_WALLPAPER", "1", 1);
