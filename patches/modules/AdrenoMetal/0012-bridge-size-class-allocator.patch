From: pdx203 <noreply@anthropic.com>
Subject: bridge: a size-class cache in front of the system allocator

The runtime drops a render encoder's lowering at every end_encoding; through libmalloc its 1-15 KiB blocks took the small
region's madvise path and larger ones a VM allocation each, and Dusklight's main thread spent most of its time in the kernel
there. Blocks of 1 KiB to 1 MiB (alignment at most 16) are rounded to four classes per power of two and reused from free
lists (64 MiB at most, 16 MiB a class); the cache only holds system blocks and maps nothing itself. Dusklight's main thread
went from ~170% CPU (75 kernel) to ~100% (madvise 68 -> 5 samples, mach_vm_map 25 -> 5).

--- a/bridge/NativeMetalBridge.rs
+++ b/bridge/NativeMetalBridge.rs
@@ -13,6 +13,9 @@
 
 // The system allocator: mimalloc reserved its arenas with large mmaps, and on iPadOS 27 the kernel stopped the render server and
 // SpringBoard with an exception inside that mmap (unix_mmap_prim_aligned from mi_arena_reserve), so the shell resprung.
+// pdx203: behind a size-class cache of the system's own blocks (NativeBridgeAlloc.rs), which maps nothing itself.
+#[path = "NativeBridgeAlloc.rs"]
+mod alloc_pool;
 
 use metal2vulkan::metal::{PixelFormat, PrimitiveType, TextureUsage};
 use metal2vulkan::pipeline::{ColorAttachmentDescriptor, RenderPipelineDescriptor, StageSource};
--- /dev/null
+++ b/bridge/NativeBridgeAlloc.rs
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: MIT
+//! A size-class cache in front of the system allocator for the bridge's Rust code (pdx203, 2026-11-06).
+//!
+//! The runtime builds and drops a render encoder's lowering for every encoder (hash maps, vectors of commands and resources).
+//! Freed through libmalloc, its 1-15 KiB blocks take the small region's free path, which hands whole free pages back to the kernel
+//! with madvise (`small_madvise_free_range_no_lock`), and its larger ones are their own VM allocations (`mach_vm_map` and a
+//! deallocation each). Dusklight's main thread spent about three quarters of its time in the kernel, two fifths of that in those
+//! calls from `RenderCommandEncoder::end_encoding`. Here blocks of 1 KiB to 1 MiB (alignment at most 16) are rounded up to one of
+//! four classes per power of two and kept on a free list of their class when freed, then handed out again: the steady state of
+//! encoders made and dropped every frame reaches neither madvise nor the VM. The cache only holds blocks the system allocator
+//! made, never maps memory itself (mimalloc's arena reservations were what iPadOS 27 stopped the render server for), and keeps
+//! at most `RETAINED_LIMIT` bytes; past it a freed block goes back to the system.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::ptr;
+use std::sync::atomic::{AtomicBool, AtomicPtr, AtomicU64, AtomicUsize, Ordering};
+
+/// Blocks above this size class go to the system directly (tiny-region sizes never madvise).
+const MIN_POOLED: usize = 1024;
+/// Blocks up to this size are pooled.
+const MAX_POOLED: usize = 1 << 20;
+/// log2(MIN_POOLED): class octaves start here.
+const FIRST_OCTAVE: u32 = 10;
+/// Classes: four per power of two from (1 KiB, 2 KiB] to (512 KiB, 1 MiB].
+const CLASSES: usize = 4 * 10;
+/// The most bytes all free lists hold together.
+const RETAINED_LIMIT: usize = 64 << 20;
+/// The most bytes one class holds (so one size cannot take the whole budget).
+const CLASS_LIMIT: usize = 16 << 20;
+/// The alignment libmalloc guarantees; a stricter layout goes to the system.
+const SYSTEM_ALIGN: usize = 16;
+
+/// A free list: freed blocks linked through their first word, under a spin lock (critical sections are a few loads and stores).
+struct FreeList {
+    lock: AtomicBool,
+    head: AtomicPtr<u8>,
+    bytes: AtomicUsize,
+}
+
+impl FreeList {
+    const fn new() -> Self {
+        Self { lock: AtomicBool::new(false), head: AtomicPtr::new(ptr::null_mut()), bytes: AtomicUsize::new(0) }
+    }
+    fn lock(&self) {
+        while self.lock.compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed).is_err() {
+            std::hint::spin_loop();
+        }
+    }
+    fn unlock(&self) {
+        self.lock.store(false, Ordering::Release);
+    }
+}
+
+static LISTS: [FreeList; CLASSES] = [const { FreeList::new() }; CLASSES];
+static RETAINED: AtomicUsize = AtomicUsize::new(0);
+/// [hits, misses (a new system block), cached on free, returned to the system on free (over a limit)].
+static COUNTS: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+
+/// The class of a request of `size` bytes and the class's block size, or None for a size outside the pooled range.
+#[inline]
+fn class_of(size: usize) -> Option<(usize, usize)> {
+    if !(MIN_POOLED + 1..=MAX_POOLED).contains(&size) {
+        return None;
+    }
+    // 2^octave < size <= 2^(octave+1); the octave's four classes end at base + step, + 2 step, + 3 step, + 4 step.
+    let octave = usize::BITS - 1 - (size - 1).leading_zeros();
+    let base = 1usize << octave;
+    let step = base / 4;
+    let within = (size - 1 - base) / step;
+    let class = (octave - FIRST_OCTAVE) as usize * 4 + within;
+    Some((class, base + (within + 1) * step))
+}
+
+pub struct PooledAllocator;
+
+unsafe impl GlobalAlloc for PooledAllocator {
+    #[inline]
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        if layout.align() > SYSTEM_ALIGN {
+            return unsafe { System.alloc(layout) };
+        }
+        let Some((class, block)) = class_of(layout.size()) else {
+            return unsafe { System.alloc(layout) };
+        };
+        let list = &LISTS[class];
+        list.lock();
+        let head = list.head.load(Ordering::Relaxed);
+        if !head.is_null() {
+            let next = unsafe { (head as *mut *mut u8).read() };
+            list.head.store(next, Ordering::Relaxed);
+            list.bytes.fetch_sub(block, Ordering::Relaxed);
+            list.unlock();
+            RETAINED.fetch_sub(block, Ordering::Relaxed);
+            COUNTS[0].fetch_add(1, Ordering::Relaxed);
+            return head;
+        }
+        list.unlock();
+        COUNTS[1].fetch_add(1, Ordering::Relaxed);
+        unsafe { System.alloc(Layout::from_size_align_unchecked(block, SYSTEM_ALIGN)) }
+    }
+
+    #[inline]
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        if layout.align() > SYSTEM_ALIGN {
+            return unsafe { System.dealloc(ptr, layout) };
+        }
+        let Some((class, block)) = class_of(layout.size()) else {
+            return unsafe { System.dealloc(ptr, layout) };
+        };
+        let list = &LISTS[class];
+        if RETAINED.load(Ordering::Relaxed) + block <= RETAINED_LIMIT && list.bytes.load(Ordering::Relaxed) + block <= CLASS_LIMIT {
+            list.lock();
+            unsafe { (ptr as *mut *mut u8).write(list.head.load(Ordering::Relaxed)) };
+            list.head.store(ptr, Ordering::Relaxed);
+            list.bytes.fetch_add(block, Ordering::Relaxed);
+            list.unlock();
+            RETAINED.fetch_add(block, Ordering::Relaxed);
+            COUNTS[2].fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+        COUNTS[3].fetch_add(1, Ordering::Relaxed);
+        unsafe { System.dealloc(ptr, Layout::from_size_align_unchecked(block, SYSTEM_ALIGN)) }
+    }
+
+    #[inline]
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        if layout.align() > SYSTEM_ALIGN || class_of(layout.size()).is_none() {
+            return unsafe { System.alloc_zeroed(layout) };
+        }
+        let block = unsafe { self.alloc(layout) };
+        if !block.is_null() {
+            unsafe { ptr::write_bytes(block, 0, layout.size()) };
+        }
+        block
+    }
+
+    #[inline]
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        if layout.align() <= SYSTEM_ALIGN {
+            let old = class_of(layout.size());
+            let new = class_of(new_size);
+            match (old, new) {
+                // Still inside the same block.
+                (Some((a, _)), Some((b, _))) if a == b => return ptr,
+                // Neither side pooled: the system's realloc (it may grow in place).
+                (None, None) => return unsafe { System.realloc(ptr, layout, new_size) },
+                _ => {}
+            }
+        }
+        // Across a class or the pooled range's edge: a new block, the bytes, the old block freed (both through this allocator).
+        let new_layout = unsafe { Layout::from_size_align_unchecked(new_size, layout.align()) };
+        let block = unsafe { self.alloc(new_layout) };
+        if !block.is_null() {
+            unsafe { ptr::copy_nonoverlapping(ptr, block, layout.size().min(new_size)) };
+            unsafe { self.dealloc(ptr, layout) };
+        }
+        block
+    }
+}
+
+#[global_allocator]
+static GLOBAL: PooledAllocator = PooledAllocator;
+
+/// The cache's counters for the board log: [hits, misses, cached frees, frees returned, bytes retained now].
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn native_bridge_alloc_stats(out: *mut u64) {
+    if out.is_null() {
+        return;
+    }
+    for (i, count) in COUNTS.iter().enumerate() {
+        unsafe { out.add(i).write(count.load(Ordering::Relaxed)) };
+    }
+    unsafe { out.add(4).write(RETAINED.load(Ordering::Relaxed) as u64) };
+}
