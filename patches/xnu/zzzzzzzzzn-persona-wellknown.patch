diff --git a/bsd/kern/kern_persona.c b/bsd/kern/kern_persona.c
--- a/bsd/kern/kern_persona.c
+++ b/bsd/kern/kern_persona.c
@@ -397,6 +397,51 @@ persona_lookup(uid_t id)
 	return persona;
 }
 
+/*
+ * UniXNU (patches/xnu/zzzzzzzzzn-persona-wellknown.patch): a stock device has a
+ * set of well-known low-numbered personas created during setup; a fresh port of
+ * the OS onto new hardware never ran that setup, so those ids do not exist.
+ * Privileged helpers that adopt one by number (e.g. a root-spawn into persona 99)
+ * then fail at persona_lookup() with ESRCH and the spawn never happens.  Create
+ * the requested well-known persona on demand, once, as a system persona owned by
+ * root, so the adopt resolves exactly as it would on a stock device.  The caller
+ * (spawn_validate_persona) has already required the persona-management entitlement
+ * and superuser credentials before reaching here, so this does not widen who may
+ * adopt a persona -- it only supplies an id the port never populated.
+ */
+void
+native_persona_ensure_wellknown(uid_t id)
+{
+	struct persona *persona;
+	int error = 0;
+	char login[24];
+
+	if (id == PERSONA_ID_NONE || id >= FIRST_PERSONA_ID) {
+		return;                 /* only the fixed well-known range */
+	}
+
+	persona = persona_lookup(id);
+	if (persona) {
+		persona_put(persona);   /* already present: nothing to do */
+		return;
+	}
+
+	snprintf(login, sizeof(login), "unixnu-persona-%u", id);
+	persona = persona_alloc(id, login, PERSONA_SYSTEM, NULL, 0 /* root uid */, &error);
+	if (!persona) {
+		return;
+	}
+	error = persona_init_begin(persona);
+	if (error) {
+		/* lost a race to another spawn; the winner is now in the list */
+		persona_init_end(persona, error);
+		persona_put(persona);
+		return;
+	}
+	/* on success the allocation reference becomes the permanent list reference */
+	persona_init_end(persona, 0);
+}
+
 struct persona *
 persona_lookup_and_invalidate(uid_t id)
 {
