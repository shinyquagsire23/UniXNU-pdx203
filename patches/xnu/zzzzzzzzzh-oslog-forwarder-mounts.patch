pdx203: the unified-log forwarder as /usr/bin/IOMFB_FDR_Loader, and private log data

Upstream's addon mounts, plus the pdx203 fork's mount6/mount7 (zzy-zoslog-addon-mount.patch) rewritten for them: launchd runs its
jobs from the signed job cache, so the board's forwarder replaces the cached com.apple.iomfb_fdr_loader job's executable through a
/usr/bin overlay, and a /Library/Preferences/Logging overlay turns on Enable-Private-Data.

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 7e97a25..5fcb3a4 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7219,6 +7219,10 @@ volatile int native_gpu_addon2_stage = 0;
 volatile int native_gpu_addon2_status = -1;
 volatile int native_gpu_addon3_stage = 0;
 volatile int native_gpu_addon3_status = -1;
+volatile int native_gpu_addon6_stage = 0;
+volatile int native_gpu_addon6_status = -1;
+volatile int native_gpu_addon7_stage = 0;
+volatile int native_gpu_addon7_status = -1;
 static void
 native_gpu_addon_mount(proc_t p, user_addr_t scratch, user_addr_t offset, const char *source, size_t source_size,
     const char *point, size_t point_size, const char *visible, const char *own, volatile int *stage, volatile int *status)
@@ -7674,6 +7678,20 @@ native_gpu_addon_prepare(proc_t p, user_addr_t scratch)
 	    "7570.iPadOS_17_Flat_Background-1024w-1366h@2x~ipad.ca/assets/J120.HEIC",
 	    "/Library/Wallpaper/Collections/iPadOS_17~ipad.wallpaperCollection/Wallpapers/7570.iPadOS_17_Flat-1024w-1366h@2x~ipad.wallpaper/"
 	    "7570.iPadOS_17_Flat_Background-1024w-1366h@2x~ipad.ca/J120.png", &native_gpu_addon3_stage, &native_gpu_addon3_status);
+	/* pdx203: the board's unified-log forwarder (UniXNU-pdx203 userland/OsLogConsole.mm). launchd starts its jobs from the signed job
+	 * cache, so the forwarder runs as the cached com.apple.iomfb_fdr_loader job's own executable: /private/var/ngpu/usrbin overlays
+	 * /usr/bin with an IOMFB_FDR_Loader of the owner trust cache. /private/var/ngpu/logging overlays /Library/Preferences/Logging with
+	 * Enable-Private-Data, so the forwarded lines carry what logd otherwise redacts as <private>. Scratch 0xe00 and 0xe40 lie above
+	 * everything the mounts and the install above use. */
+	static const char usrbin_source[] = "/private/var/ngpu/usrbin", usrbin_point[] = "/usr/bin";
+	native_gpu_addon_mount(p, scratch, 0xe00, usrbin_source, sizeof(usrbin_source), usrbin_point, sizeof(usrbin_point),
+	    "/usr/bin/IOMFB_FDR_Loader", "/usr/bin/IOMFB_FDR_Loader", &native_gpu_addon6_stage, &native_gpu_addon6_status);
+	static const char logging_source[] = "/private/var/ngpu/logging", logging_point[] = "/Library/Preferences/Logging";
+	native_gpu_addon_mount(p, scratch, 0xe40, logging_source, sizeof(logging_source), logging_point, sizeof(logging_point),
+	    "/Library/Preferences/Logging/Subsystems", "/Library/Preferences/Logging/com.apple.system.logging.plist",
+	    &native_gpu_addon7_stage, &native_gpu_addon7_status);
+	printf("GPUADDON mount6 (usr/bin) %d/%d mount7 (logging prefs) %d/%d\n", native_gpu_addon6_stage, native_gpu_addon6_status,
+	    native_gpu_addon7_stage, native_gpu_addon7_status);
 	native_cryptex_os_view(p, scratch);
 	native_gestalt_cache_drop(p, scratch);
 	native_ls_store_drop(p, scratch);
