 {
 	if (disableConsoleOutput) {
+#if XNU_QCOM_USB_DEBUG
+		/* pdx203: the video console mutes itself in graphics mode, and this return came before _cnputs, so the USB log
+		 * went silent when the GUI started (2026-11-01, logs/usb-06 and usb-09). Muted output still goes to USB here;
+		 * unmuted output reaches the tee in _cnputs. */
+		(void)qcom_usb_debug_write(str, (size_t)size);
+#endif
 		return;
 	}
 
@@ -611,6 +630,9 @@ void
