 static inline void
 _cnputs(char *c, int size, bool poll)
 {
+#if XNU_QCOM_USB_DEBUG
+	/* Capture raw formatted bytes before the console can drop, truncate or
+	 * redirect them.  qcom_usb_debug_write is bounded, non-blocking and safe
+	 * in any context, including before the scheduler exists; it copies into a
+	 * CPU-only backlog and never prints, allocates or waits.
+	 */
