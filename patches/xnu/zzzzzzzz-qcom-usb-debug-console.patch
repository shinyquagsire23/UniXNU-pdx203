+#if XNU_QCOM_USB_DEBUG
+		/* console_write_char -> console_write -> _cnputs already teed this
+		 * byte to USB.  Skip the fan-out only when it would re-enter the
+		 * console; serial and boot-progress consumers still get the byte.
+		 */
+		if (!qcom_usb_pe_kputc_reenters_console())
+#endif
