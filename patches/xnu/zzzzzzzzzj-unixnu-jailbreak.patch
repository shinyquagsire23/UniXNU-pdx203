diff --git a/bsd/kern/kern_cs.c b/bsd/kern/kern_cs.c
index 3e62618..4d6ba7a 100644
--- a/bsd/kern/kern_cs.c
+++ b/bsd/kern/kern_cs.c
@@ -82,6 +82,16 @@
 unsigned long cs_procs_killed = 0;
 unsigned long cs_procs_invalidated = 0;
 
+/*
+ * UniXNU: the AMFI kill switch (the 0x80 bit of the amfi boot argument) also
+ * turns the kernel's own policy layers permissive, so a development port can
+ * install and run unsigned code (TrollStore, Sileo) without a second switch.
+ * The command line is already close to its limit, so this reuses the argument
+ * AMFI reads. cs_init() sets it at STARTUP_RANK_FIRST, before any exec or
+ * fault can reach the checks that read it.
+ */
+int unixnu_jailbreak = 0;
+
 int cs_force_kill = 0;
 int cs_force_hard = 0;
 int cs_debug = 0;
@@ -185,6 +195,16 @@ cs_init(void)
 	PE_parse_boot_argn("cs_library_val_enable", &cs_library_val_enable,
 	    sizeof(cs_library_val_enable));
 #endif
+
+	/* UniXNU: amfi=0x80 is AMFI's hard bypass; the kernel follows it. */
+	int amfi_mask = 0;
+	PE_parse_boot_argn("amfi", &amfi_mask, sizeof(amfi_mask));
+	if (amfi_mask & CS_AMFI_MASK_GET_OUT_OF_MY_WAY) {
+		unixnu_jailbreak = 1;
+		cs_system_enforcement_enable = 0;
+		cs_process_enforcement_enable = 0;
+		cs_library_val_enable = 0;
+	}
 #endif /* !SECURE_KERNEL */
 }
 STARTUP(CODESIGNING, STARTUP_RANK_FIRST, cs_init);
@@ -202,8 +222,12 @@ cs_allow_invalid(struct proc *p)
 	 * kill bits will be cleared here every time. If we have
 	 * CONFIG_ENFORCE_SIGNED_CODE, we can assume there is a policy
 	 * implementing the hook.
+	 *
+	 * UniXNU: with the jailbreak switch on, CS_OPS_ALLOW_INVALID works for
+	 * every process, which is how a debugger clears kill bits on unsigned
+	 * code.
 	 */
-	if (0 != mac_proc_check_run_cs_invalid(p)) {
+	if (!unixnu_jailbreak && 0 != mac_proc_check_run_cs_invalid(p)) {
 		if (cs_debug) {
 			printf("CODE SIGNING: cs_allow_invalid() "
 			    "not allowed: pid %d\n",
@@ -254,6 +278,15 @@ cs_invalid_page(addr64_t vaddr, boolean_t *cs_killed)
 
 	p = current_proc();
 
+	/* UniXNU: the jailbreak switch allows the page and leaves the process
+	 * valid, so a modified or unsigned image can run to completion. */
+	if (unixnu_jailbreak) {
+		if (cs_killed) {
+			*cs_killed = FALSE;
+		}
+		return 0;
+	}
+
 	if (verbose) {
 		printf("CODE SIGNING: cs_invalid_page(0x%llx): p=%d[%s]\n",
 		    vaddr, proc_getpid(p), p->p_comm);
@@ -344,6 +377,11 @@ cs_process_invalidated(struct proc * __unused p)
 int
 cs_process_enforcement(struct proc *p)
 {
+	/* UniXNU: no process is code-signing enforced while the switch is on. */
+	if (unixnu_jailbreak) {
+		return 0;
+	}
+
 	if (cs_process_enforcement_enable) {
 		return 1;
 	}
@@ -401,6 +439,11 @@ cs_valid(struct proc *p)
 int
 cs_require_lv(struct proc *p)
 {
+	/* UniXNU: library validation never applies while the switch is on. */
+	if (unixnu_jailbreak) {
+		return 0;
+	}
+
 	if (cs_library_val_enable) {
 		return 1;
 	}
