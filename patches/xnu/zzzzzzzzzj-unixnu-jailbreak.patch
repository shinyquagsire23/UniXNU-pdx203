+/*
+ * UniXNU: the bitmask of the amfi boot argument, shared with the code signing
+ * setup in bsd/kern/kern_codesigning.c and the policy switch in kern_cs.c.
+ */
+#define CS_AMFI_MASK_UNRESTRICT_TASK_FOR_PID 0x01
+#define CS_AMFI_MASK_ALLOW_ANY_SIGNATURE 0x02
+#define CS_AMFI_MASK_GET_OUT_OF_MY_WAY 0x80
+
+/*
+ * UniXNU: permissive code signing and policy layers for a development port.
+ * Set by cs_init() from the get-out-of-my-way bit of the amfi boot argument.
