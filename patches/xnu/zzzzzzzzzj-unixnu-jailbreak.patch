--- a/bsd/kern/kern_codesigning.c
+++ b/bsd/kern/kern_codesigning.c
@@ -113,6 +113,8 @@ static SECURITY_READ_ONLY_LATE(code_signing_config_t) cs_config = 0;
 
 SYSCTL_UINT(_security_codesigning, OID_AUTO, monitor, CTLFLAG_RD, &cs_monitor, 0, "code signing monitor type");
 SYSCTL_UINT(_security_codesigning, OID_AUTO, config, CTLFLAG_RD, &cs_config, 0, "code signing configuration");
+/* UniXNU: read-only view of the permissive policy switch (bsd/kern/kern_cs.c). */
+SYSCTL_INT(_security_codesigning, OID_AUTO, jailbreak, CTLFLAG_RD, &unixnu_jailbreak, 0, "UniXNU permissive policy layers");
 
 void
 code_signing_configuration(
@@ -211,10 +213,6 @@ code_signing_configuration(
 	 * on RELEASE builds.
 	 */
 
-#define CS_AMFI_MASK_UNRESTRICT_TASK_FOR_PID 0x01
-#define CS_AMFI_MASK_ALLOW_ANY_SIGNATURE 0x02
-#define CS_AMFI_MASK_GET_OUT_OF_MY_WAY 0x80
-
 	int amfi_mask = 0;
 	int amfi_allow_any_signature = 0;
 	int amfi_unrestrict_task_for_pid = 0;
@@ -355,6 +353,17 @@ code_signing_configuration(
 #endif /* CONFIG_SPTM */
 #endif /* DEVELOPMENT || DEBUG */
 
+	/* UniXNU: the AMFI hard bypass also applies the same exemptions to the
+	 * kernel's own code signing checks, whatever the other boot arguments
+	 * say. tunables such as enable-dyld-export-interposing and the developer
+	 * mode features stay as they were. */
+	if (unixnu_jailbreak) {
+		config |= CS_CONFIG_ALLOW_ANY_SIGNATURE;
+		config |= CS_CONFIG_ENFORCEMENT_DISABLED;
+		config |= CS_CONFIG_GET_OUT_OF_MY_WAY;
+		config |= CS_CONFIG_UNRESTRICTED_DEBUGGING;
