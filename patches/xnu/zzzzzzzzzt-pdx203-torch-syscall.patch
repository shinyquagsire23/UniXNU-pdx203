+}
+
+/*
+ * UniXNU pdx203: the flashlight. The board's text fixups turn the camera daemon's FigFlashlight device call into this syscall;
+ * level 0 (off) .. 1000 (full) goes to the board package's PM8150L torch driver (package/Pdx203Torch.cpp).
+ */
+extern int pdx203_torch_set(int level) __attribute__((weak_import));
+
+int
+pdx203_torch(__unused struct proc *p, struct pdx203_torch_args *uap, __unused int32_t *retval)
+{
+	if (!pdx203_torch_set) {
+		return ENOSYS;
 	}
+	if (uap->level < 0 || uap->level > 1000) {
+		return EINVAL;
+	}
+	return pdx203_torch_set(uap->level) ? EIO : 0;
 }
