+/*
+ * pdx203 (patches/xnu/zzzzzzzzzc-pmap-ram-wc.patch): with pmap-ram-wc=1, RAM that is asked for as Device memory (the IO,
+ * real-time and posted cache modes; on this config real-time is Device too, no HAS_UCNORMAL_MEM) is mapped Normal
+ * non-cacheable instead. iPadOS hands display surfaces to backboardd with such a mode, and with no GPU its software
+ * renderer clears them with bzero, whose DC ZVA takes an alignment fault on any Device memory: backboardd died of SIGBUS
+ * in CA::OGL::SWContext::set_surface (2026-11-01, logs/usb-13). RAM here is the kernel's DRAM and the GOP framebuffer,
+ * which lies outside it; real MMIO keeps its Device attributes.
+ */
+#include <pexpert/pexpert.h>
+static TUNABLE(bool, pmap_ram_wc, "pmap-ram-wc", false);
+static inline bool
+pmap_ram_wc_addr(pmap_paddr_t pa)
+{
+	if (!pmap_ram_wc) {
+		return false;
+	}
+	if (is_dram_addr(pa)) {
+		return true;
+	}
+	uint64_t fb = (uint64_t)PE_state.video.v_baseAddr, bytes = (uint64_t)PE_state.video.v_rowBytes * PE_state.video.v_height;
+	return fb && pa >= fb && pa - fb < bytes;
+}
